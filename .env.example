# Change every example secret before deployment.
DB_NAME=seatsync
DB_USER=seatsync
DB_PASSWORD=replace-with-a-unique-long-database-password
DB_ROOT_PASSWORD=replace-with-a-different-long-root-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Public HTTPS URLs when deployed behind a reverse proxy.
FRONTEND_ORIGIN=https://your-domain.example
PUBLIC_API_URL=https://api.your-domain.example

# Set for initial admin creation; both values must be provided together.
SEATSYNC_ADMIN_EMAIL=admin@your-domain.example
SEATSYNC_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEATSYNC_UPI_ID=
DEMO_DATA_ENABLED=false

# Optional SMTP email notifications.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Optional Twilio SMS notifications.
SMS_NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
